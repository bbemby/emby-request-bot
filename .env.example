# ===== Telegram =====
BOT_TOKEN=
ADMIN_IDS=123456789,987654321        # 管理员 TG user id，逗号分隔
FEEDBACK_GROUP_ID=-1001234567890     # 求片反馈群组 id

# ===== Emby =====
EMBY_URL=https://your-emby.example.com
EMBY_API_KEY=

# ===== 下载 / 上传 =====
ARIA2_BIN=aria2c
JAVDB_BIN=/home/user/bin/javdb        # javdb-cli 二进制路径
DOWNLOAD_DIR=/home/user/downloads
RCLONE_BIN=rclone
RCLONE_REMOTE=gdrive                 # rclone config 里的 remote 名
RCLONE_DEST=emby-requests             # Drive 目标文件夹

# ===== 调度 =====
CHECK_INTERVAL_MIN=30                # 入库检查间隔（分钟）

# ===== 搜番 =====
MAGNET_COUNT=3
RATE_LIMIT_SECONDS=3
CACHE_TTL=3600
TRANS_TARGET=zh-CN

DB_PATH=/home/user/.emby-request-bot.db
